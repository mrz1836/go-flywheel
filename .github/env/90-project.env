# ================================================================================================
# 🏃 PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific configuration for this repo
# Load Order: 90 (loaded last, overrides all default tool configs)
#
# ================================================================================================

# ================================================================================================
# 📦 GO MODULE CONFIGURATION (overrides 00-core.env)
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.25.x
GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_SECONDARY_VERSION=1.25.x
MAGE_X_GO_VERSION=1.25.x

# Dev-build install location: magex build:dev installs here (kept on PATH ahead of
# GOBIN) so a freshly built binary is not shadowed by an older release install.
# Honored by mage-x versions that support it; harmlessly ignored by older ones.
MAGE_X_INSTALL_DIR=~/.local/bin

# Standard go.sum location at repo root
GO_SUM_FILE=go.sum

# ================================================================================================
# 🛡️ CVE EXCLUSION OVERRIDES
# ================================================================================================

# Custom exclusions for AskNancy vulnerability scanning
NANCY_EXCLUDES=CVE-2024-38513

# Custom exclusions for Govulncheck/Magex vulnerability scanning
MAGE_X_CVE_EXCLUDES=CVE-2026-56852

# ================================================================================================
# 📊 COVERAGE CONFIGURATION (overrides 10-coverage.env)
# ================================================================================================

# Coverage Provider
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,docs/,example/,examples/,loadtest/,vendor/,testdata/,testing/

# ================================================================================================
# 🏋️ LOAD-HARNESS BUILD TAG (overrides 10-mage-x.env)
# ================================================================================================

# The loadtest/ package is the runtime's load, soak, and chaos harness. Its runs take minutes to
# hours against a real PostgreSQL server, so it must never join the default test matrix. Build-tag
# auto-discovery finds every tag in the tree and combines them, which without this line means
# `magex test` runs "integration+loadtest" on every invocation.
#
# This restates the whole list from 10-mage-x.env rather than appending to it, and the reason is
# worth writing down because the shorter form looks correct and is not. Appending with
# `${MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE:-},loadtest` would keep this repo inheriting upstream
# additions to the GOOS/GOARCH list — but magex reads these files directly and performs no shell
# expansion, so it takes the literal `${...}` token, discards it, and is left excluding `loadtest`
# and nothing else. Exporting the expanded value from load-env.sh first does not help: the file
# wins over the environment. Measured, not assumed — with the append form in place, a scratch file
# carrying `//go:build darwin` was discovered and `magex test` ran `combined(darwin+integration)`.
#
# The cost is that an upstream addition to the list below has to be copied here. That is a stale
# copy, which is a real maintenance cost; silently losing every GOOS and GOARCH exclusion is a
# broken test matrix, which is worse. The harness's own platform-specific files
# (//go:build loadtest && darwin, and its linux and fallback siblings) are exactly the case that
# would trip it.
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,msan,asan,cgo,gc,gccgo,boringcrypto,unix,aix,android,darwin,dragonfly,freebsd,hurd,illumos,ios,js,linux,nacl,netbsd,openbsd,plan9,solaris,wasip1,windows,zos,386,amd64,amd64p32,arm,armbe,arm64,arm64be,loong64,mips,mipsle,mips64,mips64le,mips64p32,mips64p32le,ppc,ppc64,ppc64le,riscv,riscv64,s390,s390x,sparc,sparc64,wasm,loadtest
