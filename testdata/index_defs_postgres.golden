idx_job_periodics_slug	CREATE UNIQUE INDEX idx_job_periodics_slug ON <schema>.job_periodics USING btree (slug)
idx_jobs_deleted_at	CREATE INDEX idx_jobs_deleted_at ON <schema>.jobs USING btree (deleted_at) WHERE (deleted_at IS NOT NULL)
job_runs_job_attempt	CREATE UNIQUE INDEX job_runs_job_attempt ON <schema>.job_runs USING btree (job_id, attempt)
jobs_parent	CREATE INDEX jobs_parent ON <schema>.jobs USING btree (parent_job_id) WHERE (parent_job_id IS NOT NULL)
jobs_ready	CREATE INDEX jobs_ready ON <schema>.jobs USING btree (queue, priority, scheduled_at) WHERE ((state = ANY (ARRAY['available'::text, 'retryable'::text, 'scheduled'::text])) AND (deleted_at IS NULL))
jobs_running_leased	CREATE INDEX jobs_running_leased ON <schema>.jobs USING btree (leased_until) WHERE (state = 'running'::text)
jobs_state	CREATE INDEX jobs_state ON <schema>.jobs USING btree (state) WHERE (deleted_at IS NULL)
jobs_unique_active_key	CREATE UNIQUE INDEX jobs_unique_active_key ON <schema>.jobs USING btree (unique_active_key) WHERE ((unique_active_key IS NOT NULL) AND (state = ANY (ARRAY['available'::text, 'running'::text, 'retryable'::text, 'scheduled'::text, 'paused'::text])))
jobs_unique_key	CREATE UNIQUE INDEX jobs_unique_key ON <schema>.jobs USING btree (unique_key) WHERE (unique_key IS NOT NULL)
